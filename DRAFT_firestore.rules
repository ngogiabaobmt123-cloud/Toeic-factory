rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Safety net: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/users/$(userId)).data.uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Rules ---
    match /users/{userId} {
      // Allowed if the user is signed in.
      // Note: We use the nickname as the document ID, so we check the UID field inside.
      allow read: if isSignedIn();
      
      // Creating a profile
      allow create: if isSignedIn() 
        && incoming().uid == request.auth.uid
        && incoming().balance == 0
        && incoming().xp == 0;

      // Updating a profile
      allow update: if isSignedIn() 
        && existing().uid == request.auth.uid
        && incoming().uid == existing().uid
        && (
          // Allow balance/xp updates during gameplay
          true 
        );
    }
  }
}
